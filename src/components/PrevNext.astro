---
import { withBase } from "@/lib/paths";
interface Props {
  bookSlug: string;
  prev?: { chapter: string; page: string; title: string };
  next?: { chapter: string; page: string; title: string };
}
const { bookSlug, prev, next } = Astro.props;
---
<nav class="prevnext">
  {prev ? (
    <a class="pn pn-prev" title={prev.title} href={withBase(`/books/${bookSlug}/${prev.chapter}/${prev.page}`)}>
      <span class="dir">← Previous</span>
      <span class="t">{prev.title}</span>
    </a>
  ) : <span />}
  {next ? (
    <a class="pn pn-next" title={next.title} href={withBase(`/books/${bookSlug}/${next.chapter}/${next.page}`)}>
      <span class="dir">Next →</span>
      <span class="t">{next.title}</span>
    </a>
  ) : <span />}
</nav>
<style>
  .prevnext {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 3em;
    padding-top: 1.4em;
    border-top: 1px solid var(--border-strong);
  }
  .pn {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    color: var(--text);
    overflow: hidden;
  }
  .pn-next { text-align: right }
  .dir {
    font-family: var(--font-sans);
    font-size: .72em;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .t {
    font-family: var(--font-serif);
    font-size: 1em;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .pn:hover .t { text-decoration: underline; text-underline-offset: .2em }
  @media (max-width: 767px) {
    .prevnext { gap: 16px; padding-top: 1em }
    .t { font-size: .94em }
  }
</style>
