---
import { withBase } from "@/lib/paths";
import type { BookTree } from "@/lib/books";
interface Props { book: { id: string; data: { title: string } }; tree: BookTree; current: { chapter: string; page: string }; }
const { book, tree, current } = Astro.props;
---
<aside class="booksidebar">
  <a class="bookhead" href={withBase(`/books/${book.id}`)}>{book.data.title}</a>
  {tree.chapters.map(c => {
    const expanded = c.pages.some(p => p.slug === current.page && c.slug === current.chapter);
    return (
      <details open={expanded}>
        <summary>{c.title}</summary>
        <ul>
          {c.pages.map(p => {
            const active = c.slug === current.chapter && p.slug === current.page;
            return (
              <li>
                <a class={active ? "active" : ""}
                   aria-current={active ? "page" : undefined}
                   href={withBase(`/books/${book.id}/${c.slug}/${p.slug}`)}>
                  {p.title}
                </a>
              </li>
            );
          })}
        </ul>
      </details>
    );
  })}
</aside>
<style>
  .booksidebar {
    width: var(--sidebar-w);
    background: var(--bg);
    border-right: 1px solid var(--border);
    padding: 1.6rem 1.2rem;
    overflow-y: auto;
    height: calc(100vh - var(--topbar-h));
    position: sticky;
    top: var(--topbar-h);
    font-family: var(--font-sans);
    font-size: .9em;
  }
  .bookhead {
    display: block;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.1em;
    color: var(--text);
    margin-bottom: 1.4em;
    padding-bottom: .8em;
    border-bottom: 1px solid var(--border-strong);
    text-decoration: none;
    line-height: 1.25;
  }
  details { margin-bottom: .4em }
  summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text);
    padding: .35em 0;
    list-style: none;
    font-size: .82em;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  summary::-webkit-details-marker { display: none }
  summary::before {
    content: "+ ";
    color: var(--text-mute);
    font-family: var(--font-mono);
  }
  details[open] summary::before { content: "− " }
  ul { list-style: none; padding: 0; margin: .35em 0 .6em }
  li a {
    display: block;
    padding: .25em 0 .25em .9em;
    color: var(--text-soft);
    text-decoration: none;
    border-left: 2px solid transparent;
    line-height: 1.45;
  }
  li a:hover { color: var(--text); border-left-color: var(--border) }
  li a.active {
    color: var(--text);
    border-left-color: var(--text);
    font-weight: 600;
  }
</style>
